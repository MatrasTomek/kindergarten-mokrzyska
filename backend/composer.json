{
  "name": "przedszkole/api",
  "type": "project",
  "require": {
    "php": "^8.4",
    "ext-mongodb": "*",
    "slim/slim": "^4.14",
    "slim/psr7": "^1.7",
    "mongodb/mongodb": "~1.15.0",
    "firebase/php-jwt": "^6.10",
    "ezyang/htmlpurifier": "^4.17",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": { "phpunit/phpunit": "^11.5" },
  "autoload": { "psr-4": { "App\\": "src/" } },
  "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
  "config": {
    "sort-packages": true,
    "platform": { "php": "8.4.22", "ext-mongodb": "1.15.3" }
  }
}
