{
  "name": "przedszkole/api",
  "type": "project",
  "require": {
    "php": "^8.4",
    "ext-mongodb": "*",
    "slim/slim": "^4.14",
    "slim/psr7": "^1.7",
    "mongodb/mongodb": "~1.15.0",
    "firebase/php-jwt": "^7.0",
    "ezyang/htmlpurifier": "^4.17",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.4.22",
      "ext-mongodb": "1.15.3"
    },
    "audit": {
      "ignore": {
        "PKSA-y93m-jgy6-r9ns": "mongodb/mongodb pinned ~1.15 (OVH ext-mongodb 1.15.3); app uses no GridFS and only constant db/collection names",
        "PKSA-61k5-cqr9-b8b4": "mongodb/mongodb pinned ~1.15 (OVH ext-mongodb 1.15.3); app uses no GridFS and only constant db/collection names"
      }
    }
  }
}