# /.htaccess nowej strony (generowany przez scripts/package.mjs, który wstawia nazwę pliku fallbacku SPA
# i politykę CSP z hashami skryptów inline z bieżącego buildu — nie edytuj CSP ręcznie na serwerze).
# Założenie: ten katalog jest katalogiem głównym (DocumentRoot) domeny nowej strony — osobny wpis
# multisite w OVH. Reguły dotyczą tylko tego katalogu i podkatalogów; stara strona w innym folderze
# nie jest dotknięta. NIE wgrywaj tego pliku do folderu starej strony.
Options -Indexes
DirectoryIndex index.html
# Prerenderowane trasy to katalogi (aktualnosci/index.html). Bez tego mod_dir robiłby 301
# /aktualnosci → /aktualnosci/; zamiast tego serwujemy plik wewnętrznie (reguła niżej).
DirectorySlash Off
RewriteEngine On

# Jeden adres strony: www → bez www (SEO: bez duplikatów treści; canonical i sitemap też są bez www), od razu na https
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# HTTPS (X-Forwarded-Proto: gdyby TLS kończył się na proxy przed Apache — chroni przed pętlą)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# API i pliki mają własne .htaccess (api/ ma własny RewriteEngine, więc i tak tu nie trafia)
RewriteRule ^(api|uploads)(/|$) - [L]

# Wpisy i grupy: powłoka aplikacji z meta tagami z bazy (App\Seo\SeoPageController — podgląd linków, wyszukiwarki)
# oraz mapa strony z bazy. Slim dostaje oryginalny REQUEST_URI (/wpis/…), więc trasy są poza prefiksem /api.
# [^/.]: slug nie ma kropki — po wewnętrznym przepisaniu /grupy → grupy/index.html (niżej) reguły biegną od nowa
# i „grupy/index.html” nie może tu trafić.
RewriteRule ^(wpis|grupy)/[^/.]+$ api/index.php [L]
RewriteRule ^sitemap\.xml$ api/index.php [L]

# Strona główna = prerenderowany index.html
RewriteRule ^$ index.html [L]

# Prerenderowane katalogi: /aktualnosci i /aktualnosci/ → aktualnosci/index.html (bez przekierowania)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

# Istniejące pliki (JS, CSS, obrazki, prerenderowane .html)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Brakujące pliki statyczne → 404, NIE powłoka SPA. Np. stara karta przeglądarki po aktualizacji prosi o usunięty
# chunk JS: HTML zamiast skryptu (przy nosniff) psułby stronę po cichu, a 404 Angular zgłasza jako błąd ładowania.
RewriteRule \.(js|css|map|woff2?|png|jpe?g|webp|svg|ico|json)$ - [NC,R=404,L]

# Trasy renderowane w przeglądarce: /admin/* i nieznane adresy (404 robi Angular, z meta robots=noindex).
# ZAWSZE index.csr.html — index.html to prerenderowana strona główna ze znacznikami hydratacji.
RewriteRule ^ /__FALLBACK__ [L]

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpg|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Content-Security-Policy "__CSP__"
  # HSTS bez includeSubDomains/preload: inne subdomeny tej domeny mogą nie mieć HTTPS. Przeglądarka ignoruje
  # ten nagłówek po zwykłym HTTP, więc zadziała dopiero po przekierowaniu na https.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
</IfModule>
